 <script setup>
-// Este componente no necesita envolver todo en Layout ya que el router ya lo hace a través de ProtectedLayout
-// El Layout ya está siendo usado en App.vue con ProtectedLayout
+import { ref, computed, onMounted } from 'vue';
+import { useToast } from 'primevue/usetoast';
+import PageHeader from '@/components/PageHeader.vue';
+import { workflowService, processService } from '@/services/api';
+import { useErrorHandler } from '@/composables/useErrorHandler';
+
+const toast = useToast();
+const { handleError } = useErrorHandler();
+
+// Board data
+const columns = ref([]);
+const totalProcesses = ref(0);
+const loading = ref(false);
+const boardRef = ref(null);
+
+// Search
+const searchQuery = ref('');
+
+const searchMatchCount = computed(() => {
+  if (!searchQuery.value) return 0;
+  const q = searchQuery.value.toLowerCase();
+  let count = 0;
+  columns.value.forEach(col => {
+    col.cards.forEach(card => {
+      if (cardMatches(card, q)) count++;
+    });
+  });
+  return count;
+});
+
+const cardMatches = (card, q) => {
+  return (card.reference && card.reference.toLowerCase().includes(q)) ||
+         (card.client_name && card.client_name.toLowerCase().includes(q)) ||
+         (card.client_identification && card.client_identification.toLowerCase().includes(q));
+};
+
+const getVisibleCards = (col) => {
+  if (!searchQuery.value) return col.cards;
+  const q = searchQuery.value.toLowerCase();
+  return col.cards.filter(card => cardMatches(card, q));
+};
+
+const isCardHighlighted = (card) => {
+  if (!searchQuery.value) return false;
+  return cardMatches(card, searchQuery.value.toLowerCase());
+};
+
+// Drag state
+const draggedCard = ref(null);
+const dragSourceColumn = ref(null);
+const dragOverStateId = ref(null);
+
+// Bulk selection
+const selectedProcessIds = ref(new Set());
+const bulkDialogVisible = ref(false);
+const bulkTargetStateId = ref(null);
+const bulkObservations = ref('');
+const bulkLoading = ref(false);
+
+const selectedCount = computed(() => selectedProcessIds.value.size);
+
+const allStates = computed(() =>
+  columns.value.map(col => ({ id: col.state_id, name: col.state_name }))
+);
+
+const isSelected = (card) => selectedProcessIds.value.has(card.process_id);
+
+const toggleCard = (card, checked) => {
+  const newSet = new Set(selectedProcessIds.value);
+  if (checked) {
+    newSet.add(card.process_id);
+  } else {
+    newSet.delete(card.process_id);
+  }
+  selectedProcessIds.value = newSet;
+};
+
+const selectAllVisible = () => {
+  const newSet = new Set(selectedProcessIds.value);
+  columns.value.forEach(col => {
+    getVisibleCards(col).forEach(card => newSet.add(card.process_id));
+  });
+  selectedProcessIds.value = newSet;
+};
+
+const clearSelection = () => {
+  selectedProcessIds.value = new Set();
+};
+
+const openBulkDialog = () => {
+  bulkTargetStateId.value = null;
+  bulkObservations.value = '';
+  bulkDialogVisible.value = true;
+};
+
+const executeBulkTransition = async () => {
+  if (!bulkTargetStateId.value || selectedProcessIds.value.size === 0) return;
+  bulkLoading.value = true;
+  try {
+    const ids = Array.from(selectedProcessIds.value);
+    const response = await workflowService.bulkTransition(ids, bulkTargetStateId.value, bulkObservations.value || null);
+    const { updated, failed, target_state_name } = response.data;
+    toast.add({
+      severity: failed > 0 ? 'warn' : 'success',
+      summary: 'Cambio masivo ejecutado',
+      detail: `${updated} procesos movidos a "${target_state_name}"${failed > 0 ? `, ${failed} con error` : ''}`,
+      life: 5000,
+    });
+    bulkDialogVisible.value = false;
+    clearSelection();
+    await loadKanban();
+  } catch (error) {
+    handleError(error, 'Error ejecutando cambio masivo');
+  } finally {
+    bulkLoading.value = false;
+  }
+};
+
+// Detail dialog
+const detailVisible = ref(false);
+const detailCard = ref(null);
+const detailCardColumn = ref(null);
+
+// Transition dialog
+const transitionVisible = ref(false);
+const transitionCard = ref(null);
+const transitionColumn = ref(null);
+const selectedTargetStateId = ref(null);
+const transitionObservations = ref('');
+const transitionLoading = ref(false);
+
+// Computed
+const detailCardStateName = computed(() => detailCardColumn.value?.state_name || '');
+const detailCardStateCode = computed(() => detailCardColumn.value?.state_code || '');
+const detailCardTransitions = computed(() => detailCardColumn.value?.transitions || []);
+const transitionFromColumnName = computed(() => transitionColumn.value?.state_name || '');
+
+const transitionTargets = computed(() => {
+  if (!transitionColumn.value) return [];
+  const targetIds = transitionColumn.value.transitions || [];
+  return columns.value
+    .filter(col => targetIds.includes(col.state_id))
+    .map(col => ({ id: col.state_id, name: col.state_name }));
+});
+
+onMounted(() => {
+  loadKanban();
+});
+
+const loadKanban = async () => {
+  loading.value = true;
+  try {
+    const response = await workflowService.getKanban();
+    const data = response.data;
+    columns.value = data.columns || [];
+    totalProcesses.value = data.total_processes || 0;
+  } catch (error) {
+    handleError(error, 'No se pudo cargar el tablero Kanban');
+  } finally {
+    loading.value = false;
+  }
+};
+
+// Drag & Drop
+const onDragStart = (event, card, column) => {
+  draggedCard.value = card;
+  dragSourceColumn.value = column;
+  event.dataTransfer.effectAllowed = 'move';
+  event.target.classList.add('dragging');
+};
+
+const onDragOver = (event, column) => {
+  if (!draggedCard.value || !dragSourceColumn.value) return;
+  // Only allow drop if there's a valid transition
+  const sourceTransitions = dragSourceColumn.value.transitions || [];
+  if (sourceTransitions.includes(column.state_id) || dragSourceColumn.value.state_id === column.state_id) {
+    dragOverStateId.value = column.state_id;
+    event.dataTransfer.dropEffect = 'move';
+  }
+};
+
+const onDragLeave = () => {
+  dragOverStateId.value = null;
+};
+
+const onDrop = async (event, targetColumn) => {
+  event.preventDefault();
+  dragOverStateId.value = null;
+  const card = draggedCard.value;
+  const sourceCol = dragSourceColumn.value;
+
+  if (!card || !sourceCol || sourceCol.state_id === targetColumn.state_id) {
+    draggedCard.value = null;
+    dragSourceColumn.value = null;
+    return;
+  }
+
+  // Check if transition is valid
+  const validTransitions = sourceCol.transitions || [];
+  if (!validTransitions.includes(targetColumn.state_id)) {
+    toast.add({
+      severity: 'warn',
+      summary: 'Transición no válida',
+      detail: `No se puede mover de "${sourceCol.state_name}" a "${targetColumn.state_name}"`,
+      life: 4000
+    });
+    draggedCard.value = null;
+    dragSourceColumn.value = null;
+    return;
+  }
+
+  // Execute transition
+  try {
+    await processService.transition(card.process_id, targetColumn.state_id, 'Movimiento Kanban');
+    toast.add({
+      severity: 'success',
+      summary: 'Éxito',
+      detail: `Proceso movido a "${targetColumn.state_name}"`,
+      life: 3000
+    });
+    await loadKanban();
+  } catch (error) {
+    handleError(error, 'No se pudo mover el proceso');
+  } finally {
+    draggedCard.value = null;
+    dragSourceColumn.value = null;
+  }
+};
+
+const onDragEnd = (event) => {
+  event.target.classList.remove('dragging');
+  draggedCard.value = null;
+  dragSourceColumn.value = null;
+  dragOverStateId.value = null;
+};
+
+// Detail
+const openCardDetail = (card) => {
+  detailCard.value = card;
+  detailCardColumn.value = columns.value.find(col =>
+    col.cards.some(c => c.process_id === card.process_id)
+  );
+  detailVisible.value = true;
+};
+
+const openTransitionFromDetail = () => {
+  const col = detailCardColumn.value;
+  detailVisible.value = false;
+  if (col && detailCard.value) {
+    openTransition(detailCard.value, col);
+  }
+};
+
+// Transition
+const openTransition = (card, column) => {
+  transitionCard.value = card;
+  transitionColumn.value = column;
+  selectedTargetStateId.value = null;
+  transitionObservations.value = '';
+  transitionVisible.value = true;
+};
+
+const confirmTransition = async () => {
+  if (!selectedTargetStateId.value || !transitionCard.value) return;
+  transitionLoading.value = true;
+  try {
+    const targetName = transitionTargets.value.find(t => t.id === selectedTargetStateId.value)?.name || '';
+    await processService.transition(
+      transitionCard.value.process_id,
+      selectedTargetStateId.value,
+      transitionObservations.value || `Movimiento desde Kanban`
+    );
+    toast.add({
+      severity: 'success',
+      summary: 'Éxito',
+      detail: `Estado cambiado a ${targetName}`,
+      life: 3000
+    });
+    transitionVisible.value = false;
+    await loadKanban();
+  } catch (error) {
+    handleError(error, 'No se pudo ejecutar la transición');
+  } finally {
+    transitionLoading.value = false;
+  }
+};
+
+// Helpers
+const getCardClass = (card) => {
+  if (!card.max_days) return '';
+  const ratio = card.days_in_state / card.max_days;
+  if (ratio >= 1) return 'card-expired';
+  if (ratio >= 0.75) return 'card-warning';
+  return '';
+};
+
+const getDaysClass = (card) => {
+  if (!card.max_days) return 'days-neutral';
+  const ratio = card.days_in_state / card.max_days;
+  if (ratio >= 1) return 'days-expired';
+  if (ratio >= 0.75) return 'days-warning';
+  return 'days-ok';
+};
+
+const getSeverityByCode = (code) => {
+  if (code.includes('PAGADO')) return 'success';
+  if (code.includes('INCOBRABLE') || code.includes('INCUMPLIDO')) return 'danger';
+  if (code.includes('ARCHIVADO')) return 'secondary';
+  if (code.includes('COBRO') || code.includes('NOTIFICACION')) return 'warning';
+  return 'info';
+};
+
+const formatCurrency = (amount) => {
+  if (!amount && amount !== 0) return '-';
+  return new Intl.NumberFormat('es-CO', {
+    style: 'currency', currency: 'COP', minimumFractionDigits: 0
+  }).format(amount);
+};
+
+const formatDate = (dateString) => {
+  if (!dateString) return '-';
+  return new Date(dateString).toLocaleDateString('es-CO', {
+    year: 'numeric', month: 'short', day: 'numeric'
+  });
+};
 </script>
 
