+// Función para obtener iniciales del nombre
+const getInitials = (name) => {
+  if (!name) return 'U';
+  return name
+    .split(' ')
+    .map(n => n.charAt(0))
+    .join('')
+    .substring(0, 2)
+    .toUpperCase();
+};
+
+// Función para alternar el menú de usuario
+const toggleUserMenu = (event) => {
+  userMenuRef.value.toggle(event);
+};
+
+// Función para manejar el cierre de sesión
+const handleLogout = async () => {
+  try {
+    await authStore.logout(); // Llama al logout del store que también llama al backend
+    router.push('/login');
+  } catch (error) {
+    console.error('Error during logout:', error);
+    // Asegurar que se limpie la sesión incluso si hay un error
+    authStore.logout();
+    router.push('/login');
+  }
+};
+
+// Funciones para el selector de tenant
+const getTenantName = (tenantId) => {
+  const tenant = authStore.availableTenants.find(t => t.tenant_id === tenantId);
+  return tenant?.tenant_name || `Tenant #${tenantId}`;
+};
+
+const onTenantSwitch = async (tenantId) => {
+  if (tenantId === authStore.activeTenantId) return;
+  await authStore.switchTenant(tenantId);
+  // Recargar la pagina para refrescar todos los datos con el nuevo tenant
+  window.location.reload();
+};
