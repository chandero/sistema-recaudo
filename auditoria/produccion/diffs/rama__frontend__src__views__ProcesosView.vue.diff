 <script setup>
+import { ref, onMounted } from 'vue';
+import { useToast } from 'primevue/usetoast';
+import PageHeader from '@/components/PageHeader.vue';
+import DataTableWrapper from '@/components/DataTableWrapper.vue';
+import Sidebar from 'primevue/sidebar';
+import { processService, workflowService, agreementService } from '@/services/api';
+import { useErrorHandler } from '@/composables/useErrorHandler';
+
+const toast = useToast();
+const { handleError } = useErrorHandler();
+
+// Data
+const processes = ref([]);
+const workflowStates = ref([]);
+const loading = ref(false);
+const totalRecords = ref(0);
+const tableFirst = ref(0);
+const tableRows = ref(20);
+const searchQuery = ref('');
+const selectedStateId = ref(null);
+const stats = ref({ active: 0, suspended: 0, closed: 0 });
+
+// Detail drawer
+const detailVisible = ref(false);
+const detailData = ref(null);
+const detailTimeline = ref([]);
+
+// Transition dialog
+const transitionVisible = ref(false);
+const transitionProcess = ref(null);
+const selectedTransitionId = ref(null);
+const transitionObservations = ref('');
+const transitionLoading = ref(false);
+
+// Timeline dialog
+const timelineVisible = ref(false);
+const timelineProcess = ref(null);
+const timelineData = ref([]);
+const timelineLoading = ref(false);
+
+// Agreement management
+const agreementCreateVisible = ref(false);
+const agreementDetailVisible = ref(false);
+const agreementPayVisible = ref(false);
+const agreementLoading = ref(false);
+const agreementDetail = ref(null);
+const agreementInstallments = ref([]);
+const selectedInstallment = ref(null);
+const payAmount = ref(0);
+const payObservations = ref('');
+const newAgreement = ref({
+  total_debt: 0,
+  total_agreed: 0,
+  interest_rate: 0,
+  installment_count: 1,
+  first_payment_date: new Date(),
+  payment_day: 1,
+  grace_period_months: 0,
+  default_interest_rate: 0,
+  observations: '',
+});
+
+// Table columns
+const tableColumns = ref([
+  { field: 'reference', header: 'Referencia', sortable: true },
+  { field: 'current_state_id', header: 'Estado', sortable: false },
+  { field: 'status', header: 'Proceso', sortable: true },
+  { field: 'state_changed_at', header: 'Cambio Estado', sortable: true },
+  { field: 'observation', header: 'Observación', sortable: false },
+  { field: 'actions', header: 'Acciones', style: 'width: 140px' }
+]);
+
+// State map for quick lookup
+const stateMap = ref({});
+
+onMounted(async () => {
+  await loadWorkflowStates();
+  await loadProcesses();
+  await loadStats();
+});
+
+const loadWorkflowStates = async () => {
+  try {
+    const response = await workflowService.getStates();
+    workflowStates.value = response.data || [];
+    const map = {};
+    workflowStates.value.forEach(s => { map[s.id] = s; });
+    stateMap.value = map;
+  } catch (error) {
+    console.error('Error loading workflow states:', error);
+  }
+};
+
+const loadProcesses = async () => {
+  loading.value = true;
+  try {
+    const page = Math.floor(tableFirst.value / tableRows.value) + 1;
+    const params = {
+      page,
+      page_size: tableRows.value,
+    };
+    if (selectedStateId.value) {
+      params.state_id = selectedStateId.value;
+    }
+    if (searchQuery.value) {
+      params.search = searchQuery.value;
+    }
+    const response = await processService.getAll(params);
+    const data = response.data;
+    if (data && data.items) {
+      processes.value = data.items;
+      totalRecords.value = data.total;
+    } else {
+      processes.value = data || [];
+      totalRecords.value = processes.value.length;
+    }
+  } catch (error) {
+    handleError(error, 'No se pudieron cargar los procesos');
+  } finally {
+    loading.value = false;
+  }
+};
+
+const loadStats = async () => {
+  try {
+    const response = await processService.getStats();
+    const data = response.data;
+    stats.value = {
+      active: data.active_processes || 0,
+      suspended: data.suspended_processes || 0,
+      closed: data.closed_processes || 0,
+    };
+  } catch (error) {
+    console.error('Error loading stats:', error);
+  }
+};
+
+const onPageChange = async (event) => {
+  tableFirst.value = event.first;
+  tableRows.value = event.rows;
+  await loadProcesses();
+};
+
+const onSearchChange = (value) => {
+  searchQuery.value = value.trim();
+  tableFirst.value = 0;
+  loadProcesses();
+};
+
+const onStateFilterChange = () => {
+  tableFirst.value = 0;
+  loadProcesses();
+};
+
+// State helpers
+const getStateName = (stateId) => {
+  return stateMap.value[stateId]?.name || stateMap.value[stateId]?.code || `Estado ${stateId}`;
+};
+
+const getStateSeverity = (stateId) => {
+  const code = stateMap.value[stateId]?.code || '';
+  if (code.includes('PAGADO')) return 'success';
+  if (code.includes('INCOBRABLE') || code.includes('INCUMPLIDO')) return 'danger';
+  if (code.includes('ARCHIVADO') || code.includes('CERRADO')) return 'secondary';
+  if (code.includes('ACUERDO') || code.includes('SEGUIMIENTO')) return 'info';
+  if (code.includes('COBRO') || code.includes('NOTIFICACION')) return 'warning';
+  return 'info';
+};
+
+const getStatusLabel = (status) => {
+  const labels = { ACTIVE: 'Activo', SUSPENDED: 'Suspendido', CLOSED: 'Cerrado' };
+  return labels[status] || status;
+};
+
+const getStatusSeverity = (status) => {
+  const severities = { ACTIVE: 'success', SUSPENDED: 'warning', CLOSED: 'secondary' };
+  return severities[status] || 'info';
+};
+
+const getDaysInField = (rowData) => {
+  if (!rowData.state_changed_at) return null;
+  const changed = new Date(rowData.state_changed_at);
+  const now = new Date();
+  return Math.floor((now - changed) / (1000 * 60 * 60 * 24));
+};
+
+const getDaysInState = (rowData) => getDaysInField(rowData);
+
+const getDaysClass = (rowData) => {
+  const days = getDaysInField(rowData);
+  const maxDays = stateMap.value[rowData.current_state_id]?.max_days;
+  if (!days || !maxDays) return '';
+  const ratio = days / maxDays;
+  if (ratio >= 1) return 'days-expired';
+  if (ratio >= 0.75) return 'days-warning';
+  return 'days-ok';
+};
+
+const hasTransitions = (rowData) => {
+  return rowData.available_transitions?.length > 0;
+};
+
+// Detail
+const openDetail = async (process) => {
+  try {
+    const response = await processService.getDetail(process.id);
+    detailData.value = response.data;
+    // Load a few timeline entries
+    const timelineResponse = await processService.getTimeline(process.id);
+    detailTimeline.value = timelineResponse.data || [];
+    detailVisible.value = true;
+  } catch (error) {
+    handleError(error, 'No se pudo cargar el detalle del proceso');
+  }
+};
+
+// Transition
+const openTransition = (process) => {
+  if (!process.available_transitions?.length) {
+    // Load detail to get transitions
+    processService.getDetail(process.id).then(response => {
+      transitionProcess.value = response.data;
+      selectedTransitionId.value = null;
+      transitionObservations.value = '';
+      transitionVisible.value = true;
+    }).catch(error => {
+      handleError(error, 'No se pudieron cargar las transiciones disponibles');
+    });
+    return;
+  }
+  transitionProcess.value = process;
+  selectedTransitionId.value = null;
+  transitionObservations.value = '';
+  transitionVisible.value = true;
+};
+
+const executeTransition = async (processId, targetStateId, stateName) => {
+  if (!confirm(`¿Desea cambiar el estado a "${stateName}"?`)) return;
+  try {
+    await processService.transition(processId, targetStateId, 'Transición ejecutada desde detalle');
+    toast.add({ severity: 'success', summary: 'Éxito', detail: `Estado cambiado a ${stateName}`, life: 3000 });
+    await loadProcesses();
+    await loadStats();
+    // Refresh detail
+    const response = await processService.getDetail(processId);
+    detailData.value = response.data;
+  } catch (error) {
+    handleError(error, 'No se pudo ejecutar la transición');
+  }
+};
+
+const confirmTransition = async () => {
+  if (!selectedTransitionId.value || !transitionProcess.value) return;
+  transitionLoading.value = true;
+  try {
+    const stateName = stateMap.value[selectedTransitionId.value]?.name || 'nuevo estado';
+    await processService.transition(
+      transitionProcess.value.id,
+      selectedTransitionId.value,
+      transitionObservations.value
+    );
+    toast.add({ severity: 'success', summary: 'Éxito', detail: `Estado cambiado a ${stateName}`, life: 3000 });
+    transitionVisible.value = false;
+    await loadProcesses();
+    await loadStats();
+  } catch (error) {
+    handleError(error, 'No se pudo ejecutar la transición');
+  } finally {
+    transitionLoading.value = false;
+  }
+};
+
+// Timeline
+const openTimeline = async (process) => {
+  timelineProcess.value = process;
+  timelineVisible.value = true;
+  timelineLoading.value = true;
+  try {
+    const response = await processService.getTimeline(process.id);
+    timelineData.value = response.data || [];
+  } catch (error) {
+    handleError(error, 'No se pudo cargar el historial');
+  } finally {
+    timelineLoading.value = false;
+  }
+};
+
+const getActionClass = (action) => {
+  if (action.includes('TRANSICION') || action.includes('CAMBIO')) return 'dot-transition';
+  if (action.includes('ASIGNACION')) return 'dot-assignment';
+  if (action.includes('CREACION')) return 'dot-creation';
+  return 'dot-default';
+};
+
+// Format helpers
+const formatDate = (dateString) => {
+  if (!dateString) return '-';
+  return new Date(dateString).toLocaleDateString('es-CO', {
+    year: 'numeric', month: 'short', day: 'numeric'
+  });
+};
+
+const formatDateTime = (dateString) => {
+  if (!dateString) return '-';
+  return new Date(dateString).toLocaleDateString('es-CO', {
+    year: 'numeric', month: 'short', day: 'numeric',
+    hour: '2-digit', minute: '2-digit'
+  });
+};
+
+const formatCurrency = (amount) => {
+  if (!amount && amount !== 0) return '-';
+  return new Intl.NumberFormat('es-CO', {
+    style: 'currency', currency: 'COP', minimumFractionDigits: 0
+  }).format(amount);
+};
+
+const formatCurrencyShort = (v) => {
+  if (v === null || v === undefined) return '0';
+  return Math.round(v).toLocaleString('es-CO');
+};
+
+const getAgreementSeverity = (s) => {
+  const map = { PROPUESTA: 'info', VIGENTE: 'success', CUMPLIDO: 'success', INCUMPLIDO: 'danger', CANCELADO: 'secondary' };
+  return map[s] || 'info';
+};
+
+const getInstallmentSeverity = (s) => {
+  const map = { PENDIENTE: 'warning', PAGADA: 'success', VENCIDA: 'danger', PARCIAL: 'info' };
+  return map[s] || 'info';
+};
+
+// Agreement actions
+const openCreateAgreement = () => {
+  const oblTotal = detailData.value?.total_amount || 0;
+  newAgreement.value = {
+    total_debt: oblTotal, total_agreed: oblTotal, interest_rate: 0,
+    installment_count: 1, first_payment_date: new Date(), payment_day: 1,
+    grace_period_months: 0, default_interest_rate: 0, observations: '',
+  };
+  agreementCreateVisible.value = true;
+};
+
+const createAgreement = async () => {
+  if (!detailData.value) return;
+  agreementLoading.value = true;
+  try {
+    await agreementService.create({
+      process_id: detailData.value.id,
+      ...newAgreement.value,
+      first_payment_date: new Date(newAgreement.value.first_payment_date).toISOString().split('T')[0],
+    });
+    agreementCreateVisible.value = false;
+    toast.add({ severity: 'success', summary: 'Acuerdo creado', detail: 'El acuerdo de pago fue creado exitosamente', life: 3000 });
+    // Refresh detail
+    const response = await processService.getDetail(detailData.value.id);
+    detailData.value = response.data;
+    await loadProcesses();
+  } catch (e) {
+    toast.add({ severity: 'error', summary: 'Error', detail: e.response?.data?.detail || 'No se pudo crear el acuerdo', life: 5000 });
+  } finally {
+    agreementLoading.value = false;
+  }
+};
+
+const viewAgreementDetail = async (agreementInfo) => {
+  agreementLoading.value = true;
+  try {
+    const resp = await agreementService.getById(agreementInfo.id);
+    agreementDetail.value = resp.data;
+    agreementInstallments.value = resp.data.installments || [];
+    agreementDetailVisible.value = true;
+  } catch (e) {
+    toast.add({ severity: 'error', summary: 'Error', detail: 'No se pudo cargar el detalle del acuerdo', life: 3000 });
+  } finally {
+    agreementLoading.value = false;
+  }
+};
+
+const acceptAgreementFromDetail = async () => {
+  if (!agreementDetail.value) return;
+  agreementLoading.value = true;
+  try {
+    await agreementService.accept(agreementDetail.value.id);
+    toast.add({ severity: 'success', summary: 'Acuerdo aceptado', detail: 'El acuerdo ahora está VIGENTE', life: 3000 });
+    agreementDetailVisible.value = false;
+    // Refresh process detail
+    const response = await processService.getDetail(detailData.value.id);
+    detailData.value = response.data;
+    await loadProcesses();
+  } catch (e) {
+    toast.add({ severity: 'error', summary: 'Error', detail: e.response?.data?.detail || 'No se pudo aceptar el acuerdo', life: 5000 });
+  } finally {
+    agreementLoading.value = false;
+  }
+};
+
+const openPayInstallment = (installment) => {
+  selectedInstallment.value = installment;
+  payAmount.value = installment.amount - installment.paid_amount;
+  payObservations.value = '';
+  agreementPayVisible.value = true;
+};
+
+const processInstallmentPayment = async () => {
+  if (!selectedInstallment.value || !agreementDetail.value) return;
+  agreementLoading.value = true;
+  try {
+    await agreementService.payInstallment(agreementDetail.value.id, selectedInstallment.value.id, {
+      paid_amount: payAmount.value,
+      observations: payObservations.value,
+    });
+    agreementPayVisible.value = false;
+    toast.add({ severity: 'success', summary: 'Pago registrado', detail: `Cuota #${selectedInstallment.value.installment_number} pagada`, life: 3000 });
+    // Reload agreement detail
+    const resp = await agreementService.getById(agreementDetail.value.id);
+    agreementDetail.value = resp.data;
+    agreementInstallments.value = resp.data.installments || [];
+    // Reload process detail
+    const response = await processService.getDetail(detailData.value.id);
+    detailData.value = response.data;
+    await loadProcesses();
+  } catch (e) {
+    toast.add({ severity: 'error', summary: 'Error', detail: e.response?.data?.detail || 'No se pudo registrar el pago', life: 5000 });
+  } finally {
+    agreementLoading.value = false;
+  }
+};
+
+const cancelAgreementFromDetail = async () => {
+  if (!agreementDetail.value) return;
+  if (!confirm('¿Está seguro de cancelar este acuerdo de pago?')) return;
+  agreementLoading.value = true;
+  try {
+    await agreementService.cancel(agreementDetail.value.id);
+    toast.add({ severity: 'warn', summary: 'Acuerdo cancelado', life: 3000 });
+    agreementDetailVisible.value = false;
+    const response = await processService.getDetail(detailData.value.id);
+    detailData.value = response.data;
+    await loadProcesses();
+  } catch (e) {
+    toast.add({ severity: 'error', summary: 'Error', detail: e.response?.data?.detail || 'No se pudo cancelar el acuerdo', life: 5000 });
+  } finally {
+    agreementLoading.value = false;
+  }
+};
+
+const exportProcesses = () => {
+  const headers = ['Referencia', 'Estado', 'Proceso', 'Cambio Estado', 'Observación'];
+  const rows = processes.value.map(p => [
+    p.reference,
+    getStateName(p.current_state_id),
+    getStatusLabel(p.status),
+    formatDate(p.state_changed_at),
+    p.observation || ''
+  ]);
+  const csv = [headers, ...rows]
+    .map(row => row.map(v => `"${String(v ?? '').replaceAll('"', '""')}"`).join(','))
+    .join('\n');
+  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
+  const url = URL.createObjectURL(blob);
+  const link = document.createElement('a');
+  link.href = url;
+  link.download = `procesos-${new Date().toISOString().slice(0, 10)}.csv`;
+  link.click();
+  URL.revokeObjectURL(url);
+};
 </script>
 
