# Database Configuration
# Variables leidas por docker-compose.yml y por app/core/config.py
DATABASE_URL=sqlite:////var/lib/cyberrit/cartera.db
# Para desarrollo local con SQLite dentro del contenedor:
# DATABASE_URL=sqlite:////app/test.db

# Obsoletas: el codigo no las lee (la conexion se arma con DATABASE_URL).
# Se conservan solo por compatibilidad historica.
DB_USER=cartera_user
DB_PASSWORD=cartera_pass
DB_NAME=cartera_db

# Seguridad
# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Superficie expuesta
# EXPOSE_API_DOCS: publica /docs, /redoc y /openapi.json. False en produccion.
# SEED_DEMO_DATA: crea Demo Tenant, estados de workflow de prueba y, si se define
#   BOOTSTRAP_ADMIN_PASSWORD, la cuenta admin. False en produccion.
EXPOSE_API_DOCS=False
SEED_DEMO_DATA=False
BOOTSTRAP_ADMIN_PASSWORD=

# Redis
REDIS_URL=redis://redis:6379/0

# Aplicacion
# production activa la validacion estricta de configuracion al arrancar
ENVIRONMENT=production
DEBUG=False

# CORS adicional (lista separada por comas), ej. https://giron.cyberrit.tiksgroup.co
BACKEND_CORS_ORIGINS=

# Invitaciones de usuarios
FRONTEND_URL=http://localhost:5173
USER_INVITATION_EXPIRE_HOURS=24
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
